LOG_LEVEL=INFO
LOG_FORMAT=console
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/accanto

# Transactions inbox: Fernet key encrypting source access tokens at rest.
# SOURCE_SECRET_KEY=
# Point at the fake YNAB server for local development (tests/fakes/ynab_server.py).
# YNAB_API_URL=http://127.0.0.1:8105/v1

# Built-in agent: "stub" for the deterministic local model, or an OpenRouter id
# such as openai/gpt-6-luna. Load a real key from a file, never commit it.
# AGENT_MODEL=stub
# OPENROUTER_API_KEY=
